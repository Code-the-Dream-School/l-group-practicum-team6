PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/l-group-practicum-team6
MONGO_URI_TEST=mongodb://127.0.0.1:27017/l-group-practicum-team6-<your-github-username>
# Dedicated E2E database — wiped/reseeded on every e2e run, must NOT match MONGO_URI
MONGO_URI_E2E=mongodb://127.0.0.1:27017/l-group-practicum-team6-e2e

# JWT_SECRET
JWT_SECRET=your_secret_here

# Admin bootstrap (seeds initial admin user on startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here
ADMIN_NAME=Admin User

# CORS
CLIENT_URL=http://localhost:5173

# Gemini AI (for shader generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Seed admin (created by `npm run seed -w backend`)
# These values are read by the seed script — set them in your local .env (never commit real values)
ADMIN_EMAIL=your_seed_admin_email@example.com
ADMIN_NAME=Admin User
ADMIN_PASSWORD=your_seed_admin_password_here
