# Variables prefixed with VITE_ are exposed to the browser.
# Only put public config here, not secrets or private tokens.

# API
VITE_API_BASE_URL=http://localhost:5001

# App
VITE_PUBLIC_APP_NAME=Sonix

# Gemini AI — exposed to the browser, use a restricted key
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-3.5-flash